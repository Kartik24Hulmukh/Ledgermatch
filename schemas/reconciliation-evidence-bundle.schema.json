{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermatch.local/schemas/reconciliation-evidence-bundle-1.1.json",
  "title": "LedgerMatch Reconciliation Evidence Bundle",
  "type": "object",
  "required": ["schema_version", "engine_version", "currency", "input_hashes", "import_profile", "config", "matches", "exceptions", "unpaid_invoices", "summary", "replay", "run_id", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "engine_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "input_hashes": {"type": "object", "required": ["bank_csv", "invoice_csv"], "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "import_profile": {"type": "object", "required": ["currency", "date_format", "precision"]},
    "config": {"type": "object"},
    "matches": {"type": "array"},
    "exceptions": {"type": "array"},
    "unpaid_invoices": {"type": "array"},
    "summary": {"type": "object", "required": ["deposits_processed", "accepted_matches", "exceptions", "matched_invoice_count", "skipped_non_deposits"]},
    "replay": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
